ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database — change to postgresql://user:pass@host/db to upgrade
DATABASE_URL=sqlite:///./portfoliolens.db

# JWT signing secret for user accounts — MUST be a long random value in
# production. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production

# CORS — in production, set to your frontend domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# yfinance timeout per ticker in seconds
TICKER_FETCH_TIMEOUT=8

# Max concurrent yfinance requests (keep ≤ 5 to avoid rate limiting)
TICKER_CONCURRENCY=5

# Optional: path to tesseract binary on Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
